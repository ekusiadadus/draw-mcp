<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron">
  <diagram name="Layers" id="layers">
    <mxGraphModel dx="1200" dy="800" page="0" defaultFontFamily="Noto Sans JP">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="layer-bg" value="Background" style="" parent="0"/>
        <mxCell id="layer-fg" value="Foreground" style="" parent="0"/>
        <mxCell id="bg-box" value="Background Box"
          style="rounded=1;fontFamily=Noto Sans JP;fontSize=18;fillColor=#f5f5f5;"
          vertex="1" parent="layer-bg">
          <mxGeometry x="100" y="100" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fg-box" value="Foreground Box"
          style="rounded=1;fontFamily=Noto Sans JP;fontSize=18;fillColor=#dae8fc;"
          vertex="1" parent="layer-fg">
          <mxGeometry x="150" y="130" width="200" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
