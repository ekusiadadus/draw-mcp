<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron">
  <diagram name="Japanese Labels" id="jp-labels-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" defaultFontFamily="Noto Sans JP">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Edges first -->
        <mxCell id="e1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;fontFamily=Noto Sans JP;"
          edge="1" parent="1" source="client" target="server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;fontFamily=Noto Sans JP;"
          edge="1" parent="1" source="server" target="database">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Title -->
        <mxCell id="title" value="日本語ラベルのシステム構成図"
          style="text;fontFamily=Noto Sans JP;fontSize=24;fontStyle=1;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Nodes with Japanese labels -->
        <mxCell id="client" value="クライアント"
          style="rounded=1;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="server" value="アプリケーションサーバー"
          style="rounded=1;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="database" value="データベース"
          style="shape=cylinder3;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#fff2cc;strokeColor=#d6b656;size=15;"
          vertex="1" parent="1">
          <mxGeometry x="115" y="420" width="180" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
