<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron">
  <diagram name="Basic Flowchart" id="flow-basic-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0" defaultFontFamily="Noto Sans JP">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Edges first for Z-order -->
        <mxCell id="e1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=2;fontFamily=Noto Sans JP;"
          edge="1" parent="1" source="start" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=2;fontFamily=Noto Sans JP;"
          edge="1" parent="1" source="step1" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vertices -->
        <mxCell id="start" value="開始"
          style="ellipse;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="処理ステップ"
          style="rounded=1;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="終了"
          style="ellipse;whiteSpace=wrap;fontFamily=Noto Sans JP;fontSize=18;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="380" width="120" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
